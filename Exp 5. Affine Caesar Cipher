#include <stdio.h>
#include <ctype.h>

int main() {
    char text[1000];
    int a, b, i;

    printf("Enter the plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter values of a and b: ");
    scanf("%d%d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    int valid = 0;

    for (i = 1; i <= 26; i++) {
        if ((a * i) % 26 == 1) {
            valid = 1;
            break;
        }
    }

    if (!valid) {
        printf("Invalid value of a");
        return 0;
    }

    for (i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i]))
            text[i] = ((a * (text[i] - 'A') + b) % 26) + 'A';
        else if (islower(text[i]))
            text[i] = ((a * (text[i] - 'a') + b) % 26) + 'a';
    }

    printf("Ciphertext: %s", text);

    return 0;
}
