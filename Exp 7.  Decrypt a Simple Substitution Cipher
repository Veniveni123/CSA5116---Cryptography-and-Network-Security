#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char text[2000], key[27];
    int i;

    printf("Enter ciphertext:\n");
    fgets(text, sizeof(text), stdin);

    printf("Enter decryption key (26 letters): ");
    scanf("%26s", key);

    if (strlen(key) != 26) {
        printf("Invalid key");
        return 0;
    }

    for (i = 0; i < 26; i++)
        key[i] = toupper(key[i]);

    for (i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i]))
            text[i] = key[text[i] - 'A'];
        else if (islower(text[i]))
            text[i] = tolower(key[text[i] - 'a']);
    }

    printf("Decrypted message:\n%s", text);

    return 0;
}
