#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[100], text[500];
    char matrix[5][5], used[26] = {0};
    int i, j, n = 0, r, c;
    int r1, c1, r2, c2;

    printf("Enter keyword: ");
    scanf("%99s", key);

    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[n / 5][n % 5] = ch;
            used[ch - 'A'] = 1;
            n++;
        }
    }

    used['J' - 'A'] = 1;

    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            matrix[n / 5][n % 5] = 'A' + i;
            n++;
        }
    }

    printf("Enter ciphertext: ");
    scanf("%499s", text);

    for (i = 0; text[i] != '\0'; i += 2) {
        char a = toupper(text[i]);
        char b = toupper(text[i + 1]);

        for (r = 0; r < 5; r++)
            for (c = 0; c < 5; c++) {
                if (matrix[r][c] == a) {
                    r1 = r;
                    c1 = c;
                }

                if (matrix[r][c] == b) {
                    r2 = r;
                    c2 = c;
                }
            }

        if (r1 == r2) {
            printf("%c%c",
                matrix[r1][(c1 + 4) % 5],
                matrix[r2][(c2 + 4) % 5]);
        } else if (c1 == c2) {
            printf("%c%c",
                matrix[(r1 + 4) % 5][c1],
                matrix[(r2 + 4) % 5][c2]);
        } else {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }
    }

    printf("\n");

    return 0;
}
