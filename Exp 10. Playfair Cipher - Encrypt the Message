#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char matrix[5][5], text[1000], msg[1000];
    int i, j, n = 0, p = 0;
    int r1, c1, r2, c2, r, c;

    printf("Enter the 25-letter matrix: ");
    scanf("%25s", text);

    if (strlen(text) != 25) {
        printf("Invalid matrix");
        return 0;
    }

    for (i = 0; i < 25; i++)
        matrix[i / 5][i % 5] = toupper(text[i]);

    getchar();

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        char ch = toupper(text[i]);

        if (ch >= 'A' && ch <= 'Z') {
            if (ch == 'J')
                ch = 'I';

            msg[n++] = ch;
        }
    }

    for (i = 0; i < n; ) {
        char a = msg[i++];
        char b;

        if (i == n)
            b = 'X';
        else if (msg[i] == a)
            b = 'X';
        else
            b = msg[i++];

        for (r = 0; r < 5; r++)
            for (c = 0; c < 5; c++) {
                if (matrix[r][c] == a) {
                    r1 = r;
                    c1 = c;
                }

                if (matrix[r][c] == b) {
                    r2 = r;
                    c2 = c;
                }
            }

        if (r1 == r2) {
            printf("%c%c",
                matrix[r1][(c1 + 1) % 5],
                matrix[r2][(c2 + 1) % 5]);
        } else if (c1 == c2) {
            printf("%c%c",
                matrix[(r1 + 1) % 5][c1],
                matrix[(r2 + 1) % 5][c2]);
        } else {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }

        p += 2;
    }

    printf("\n");

    return 0;
}
