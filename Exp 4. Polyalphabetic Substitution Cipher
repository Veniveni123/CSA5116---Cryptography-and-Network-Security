#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[1000], key[100];
    int i, j = 0, k;

    printf("Enter the plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter the key: ");
    scanf("%99s", key);

    k = strlen(key);

    if (k == 0) {
        printf("Invalid key");
        return 0;
    }

    for (i = 0; key[i] != '\0'; i++)
        key[i] = toupper(key[i]);

    for (i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i])) {
            text[i] = (text[i] - 'A' + key[j % k] - 'A') % 26 + 'A';
            j++;
        } else if (islower(text[i])) {
            text[i] = (text[i] - 'a' + key[j % k] - 'A') % 26 + 'a';
            j++;
        }
    }

    printf("Ciphertext: %s", text);

    return 0;
}
