#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[100], text[1000], matrix[5][5];
    char used[26] = {0};
    char msg[1000];
    int i, j, r, c, r1, c1, r2, c2, n = 0;

    printf("Enter keyword: ");
    scanf("%99s", key);

    printf("Enter plaintext: ");
    scanf(" %999[^\n]", text);

    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[n / 5][n % 5] = ch;
            used[ch - 'A'] = 1;
            n++;
        }
    }

    used['J' - 'A'] = 1;

    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            matrix[n / 5][n % 5] = 'A' + i;
            n++;
        }
    }

    n = 0;

    for (i = 0; text[i] != '\0'; i++) {
        char ch = toupper(text[i]);

        if (ch >= 'A' && ch <= 'Z') {
            if (ch == 'J')
                ch = 'I';

            msg[n++] = ch;
        }
    }

    msg[n] = '\0';

    char result[2000];
    int p = 0;

    for (i = 0; i < n; ) {
        char a = msg[i++];
        char b;

        if (i == n)
            b = 'X';
        else if (msg[i] == a)
            b = 'X';
        else
            b = msg[i++];

        for (r = 0; r < 5; r++)
            for (c = 0; c < 5; c++) {
                if (matrix[r][c] == a) {
                    r1 = r;
                    c1 = c;
                }
                if (matrix[r][c] == b) {
                    r2 = r;
                    c2 = c;
                }
            }

        if (r1 == r2) {
            result[p++] = matrix[r1][(c1 + 1) % 5];
            result[p++] = matrix[r2][(c2 + 1) % 5];
        } else if (c1 == c2) {
            result[p++] = matrix[(r1 + 1) % 5][c1];
            result[p++] = matrix[(r2 + 1) % 5][c2];
        } else {
            result[p++] = matrix[r1][c2];
            result[p++] = matrix[r2][c1];
        }
    }

    result[p] = '\0';

    printf("Ciphertext: %s\n", result);

    return 0;
}
