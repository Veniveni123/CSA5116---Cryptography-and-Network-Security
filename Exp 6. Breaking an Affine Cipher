#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char text[1000];
    int a, b, i, j, inv, x;

    printf("Enter the ciphertext: ");
    fgets(text, sizeof(text), stdin);

    for (a = 1; a < 26; a++) {
        int valid = 0;

        for (i = 1; i < 26; i++) {
            if ((a * i) % 26 == 1) {
                inv = i;
                valid = 1;
                break;
            }
        }

        if (!valid)
            continue;

        for (b = 0; b < 26; b++) {
            if ((a * 4 + b) % 26 == 1 &&
                (a * 19 + b) % 26 == 20) {

                printf("Possible plaintext: ");

                for (i = 0; text[i] != '\0'; i++) {
                    if (isupper(text[i])) {
                        x = (inv * (text[i] - 'A' - b + 26)) % 26;
                        printf("%c", x + 'A');
                    } else if (islower(text[i])) {
                        x = (inv * (text[i] - 'a' - b + 26)) % 26;
                        printf("%c", x + 'a');
                    } else {
                        printf("%c", text[i]);
                    }
                }

                printf("\n");
            }
        }
    }

    return 0;
}
